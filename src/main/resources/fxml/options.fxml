                                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                            </padding>
                            <children>
                                <Label text="STEP 2" />
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </VBox>   
        <VBox prefHeight="700.0" prefWidth="813.0" spacing="20.0" style="-fx-background-color: white;">
