                <VBox prefHeight="117.0" prefWidth="240.0" style="-fx-padding: 24 20 24 20;">
                    <children>
                        <Label prefHeight="50.0" prefWidth="191.0" text="STAR AUTO" textFill="#c2b7a9">
                            <font>
                                <Font name="Bookman Old Style Bold" size="27.0" />
                            </font>
                        </Label>
                        <Label text="DEALERSHIP" textFill="#a39179" />
                    </children>
                </VBox>
                <VBox prefHeight="577.0" prefWidth="240.0" spacing="10.0">
                    <children>
                        <Label alignment="CENTER" prefHeight="30.0" prefWidth="246.0" style="-fx-background-color: black;" text="CARS" textAlignment="CENTER" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="20.0" />
